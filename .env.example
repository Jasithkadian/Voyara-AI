# ==========================================
# AI TRAVEL COPILOT - CONFIGURATION TEMPLATE
# ==========================================

# --- Backend Configuration ---
# PostgreSQL URL (e.g. postgresql://user:pass@host:port/db) or SQLite (sqlite:///./flyscanner.db)
DATABASE_URL=sqlite:///./flyscanner.db
JWT_SECRET=super-secret-key-for-ai-travel-copilot-12345

# OpenAI Key (If empty, the backend operates in a high-quality local mock mode)
OPENAI_API_KEY=your_openai_api_key_here

# --- Frontend Configuration ---
# Point frontend to the backend service address
VITE_API_URL=http://localhost:8000
