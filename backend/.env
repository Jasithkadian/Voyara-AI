# Database configuration
# For PostgreSQL (Docker Compose): postgresql://postgres:postgres@db:5432/flyscanner
# Leave blank or use sqlite:///./flyscanner.db to fallback to local SQLite database automatically
DATABASE_URL=sqlite:///./flyscanner.db

# JWT secret key for token signing
JWT_SECRET=super-secret-key-for-ai-travel-copilot-12345

# OpenAI API Key (leave empty to run in local mock/simulation mode)
OPENAI_API_KEY=
